# Defaults for the SD stream server.
#
# Copy to sdkconfig (or let the build do it) and adjust. The PSRAM section is a
# hard prerequisite, not a tuning knob: see the README.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---------------------------------------------------------------------- flash
# The devkit class this targets has 16 MB of flash and 8 MB of PSRAM (N16R8).
# Set the size explicitly: the default assumption is 2 MB, which leaves the
# application partition almost full and wastes the rest of the chip.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 1.5 MB application partition rather than the 1 MB default: the firmware is
# about 0.95 MB with the Wi-Fi stack linked in.
# A 4 MB application partition (partitions.csv) instead of the 1.5 MB single-app
# layout: 16 MB of flash, no OTA, and a UI to fit.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Fine-grained pacing in the radio task (vTaskDelay at 1 ms resolution).
CONFIG_FREERTOS_HZ=1000

# app_main mounts the card, brings up Wi-Fi and starts every service, and FATFS
# plus the card print are not shallow. The default is 3584 bytes.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# ---------------------------------------------------------------------- PSRAM
# The mode is NOT auto-detected on the S3 (components/esp_psram/esp32s3/Kconfig.spiram
# has no auto option): the wrong setting corrupts memory at boot rather than
# failing cleanly. N8R8 / N16R8 class modules are normally octal. If your module
# is quad, set CONFIG_SPIRAM_MODE_QUAD instead - and set only one of the two.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_SPEED_80M=y
# Let Wi-Fi and lwIP buffers live in PSRAM, freeing internal DRAM for the
# encoder's state.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Allocations up to this size prefer internal RAM. The encoder allocates its own
# This threshold is the size below which an allocation asks internal RAM first,
# falling back to PSRAM silently (heap_caps_malloc_default, heap_caps.c). It is set
# low - small enough that no large buffer is pulled internal by accident - because
# the internal heap is the resource that decides whether Wi-Fi can start at all:
# esp_wifi_init() wants about 25 KB of *contiguous* DMA-capable internal RAM, and a
# 100 KB encoder state allocated first made it fail outright ("wifi:malloc buffer
# fail", then an abort and a reboot loop).
#
# The vendored encoder's 95 KB of state therefore lives in PSRAM now, at a measured
# cost of 7.6% of encoder throughput - 41.4% to 44.5% of one core - which is the
# price of the internal margin the rest of the system needs. In exchange the largest
# single free internal block goes from 18 432 B to 77 824 B and internal free memory
# from about 35 KB to about 155 KB. Keeping the state internal instead is possible by
# raising this to 131072 (Kconfig's maximum, just above the 95 880 B it needs), and
# that is the lever to reach for if encoder cost ever matters more than headroom.
# See docs/research/radio-player-memory-and-lvgl.md.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ------------------------------------------------------------------------ LVGL
# The UI's memory comes from PSRAM because this project says so, not because the
# default allocator happened to fall through to it:
#   - LV_USE_CUSTOM_MALLOC routes LVGL through heap_caps_malloc_prefer(PSRAM first),
#     implemented in main/ui_fit.c. Without it LVGL's many small allocations prefer
#     *internal* RAM (heap_caps_malloc_default) and silently fall back to PSRAM when
#     it runs out, which quietly spends the margin Wi-Fi needs.
#   - LV_USE_ASSERT_MALLOC turns a failed allocation into a diagnostic instead of a
#     null dereference somewhere later.
#   - CLIB string functions instead of LVGL's own copies, for flash.
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_ASSERT_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_COLOR_DEPTH_16=y
# The screen's three text sizes, and the transform support the turning reels need.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_DRAW_SW_COMPLEX=y

# ----------------------------------------------------------------------- lwIP
# MP3 at 128 kbps is 16 KB/s per client, but a burst on connect is sent at once:
# give each socket room, and count enough sockets for the listener, the
# connection tasks and every stream client.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_MAX_SOCKETS=16

# ---------------------------------------------------------------------- FATFS
# Long file names on the card, matching what the index and the download path
# assume (ML_MAX_NAME / CONFIG_FATFS_MAX_LFN).
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=128
