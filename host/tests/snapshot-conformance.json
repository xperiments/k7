  "cases": [
    {
      "name": "both bounds, inclusive",
      "args": { "duration_min": 120, "duration_max": 210 },
      "expect": ["Alpha/One/one.mp3", "Beta/Two/five.mp3", "Beta/Two/six.mp3"]
