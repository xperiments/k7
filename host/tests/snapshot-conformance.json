        "Beta/Two/six.mp3",
        "Alpha/One/one.mp3",
        "Beta/Two/five.mp3",
        "Alpha/One/two.mp3",
        "Beta/Two/four.mp3"
      ]
    },
    {
      "name": "the duration sort pages",
      "args": { "sort": "duration", "offset": 1, "limit": 2 },
      "matched": 6,
      "expect": ["Beta/Two/six.mp3", "Alpha/One/one.mp3"]
    },
    {
      "name": "a name still finds a track with no length",
      "args": { "query": "four" },
      "expect": ["Beta/Two/four.mp3"]
    },
    {
      "name": "a length range and a BPM range together",
      "args": { "bpm_min": 125, "duration_max": 210, "sort": "duration" },
      "expect": ["Alpha/One/one.mp3", "Beta/Two/five.mp3"]
    },
    {
      "name": "a length range excludes the unknown",
      "args": { "duration_max": 0.5 },
      "expect": []
    },
    {
      "name": "BPM sort puts a missing measurement last",
      "args": { "sort": "bpm" },
      "expect": [
        "Beta/Two/four.mp3",
        "Alpha/One/two.mp3",
        "Beta/Two/three.flac",
        "Alpha/One/one.mp3",
        "Beta/Two/five.mp3",
