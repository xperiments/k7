# Board settings for the Sunton 8048S050C, layered on top of sdkconfig.defaults:
#
#     idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.sunton" build
#
# Values from boards/sunton-8048s050c.json. Only what the profile states is set here;
# anything not stated stays at the project default.
CONFIG_APP_BOARD_SUNTON_8048S050C=y

# profile: psramMode octal, psramSpeedMhz 120, flashMode qio, flashSpeedMhz 120
CONFIG_SPIRAM_MODE_OCT=y

# The profile says 120 MHz for both the PSRAM and the flash, but IDF 6.1 will not build
# that on this SoC with a quad (QIO) flash: its MSPI clock rules assert that the flash
# and PSRAM module clocks agree
# (components/esp_hw_support/mspi/mspi_timing_tuning/port/esp32s3/mspi_timing_tuning_configs.h:150),
# and the same Kconfig that offers 120 MHz PSRAM sets the flash string to "80m"
# (components/esptool_py/Kconfig.projbuild:108). So this build runs the PSRAM at the
# speed IDF supports with this flash, 80 MHz, and the profile's 120 MHz row stays
# unverified until there is hardware to try it on - with the note that reaching it would
# need the flash in OPI mode as well.
CONFIG_SPIRAM_SPEED_80M=y
# DIO, not QIO: it is what the reference project uses on this board and what every build
# flashed to it so far has used. A flash mode the chip cannot boot from is a board that
# does not come up at all, which is a worse failure than a screen that stays dark.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# From the reference project's own defaults for this board, where they are part of a
# configuration that is known to drive this panel correctly:
#   - LCD_RGB_RESTART_IN_VSYNC off. Its comment in that project is the clearest statement
#     of what this project got wrong: on the S3 the driver builds the restart link from
#     framebuffer zero and never moves it to the framebuffer the panel switches to, so a
#     forced restart sends the framebuffer LVGL did not just draw "and the panel shows half
#     of the drawn frames". ESP-IDF ships it off; this states it rather than leaving it to
#     a default.
#   - instructions and rodata from PSRAM. Moving either to flash brought the panel's
#     glitches back on this board; the Artwork level is fitted around the PSRAM cost
#     instead (one cover buffer, the JPEG read on demand, no encoded copy).
# CONFIG_LCD_RGB_RESTART_IN_VSYNC is not set
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# The Shell's hashed asset names exceed SPIFFS's 32-character default;
# "/assets/unified-loader-DIIx7hKC.js" is 34.
CONFIG_SPIFFS_OBJ_NAME_LEN=64

# The front door is served over TLS; the component is compiled on purpose, not by
# accident of IDF 6.1 not gating it.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y

# The TLS listener's per-connection buffers come out of PSRAM: during playback
# internal RAM is the scarce kind.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
