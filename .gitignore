# Real Wi-Fi credentials: compiled in, deliberately not tracked
components/app/board_esp32/wifi_credentials.h

# ESP-IDF build output and configuration. `build*/
sdkconfig.sunton
sdkconfig.sunton.old` covers the extra build
# directories used to keep one IDF version's output from overwriting another's.
build*/
sdkconfig.sunton
sdkconfig.sunton.old
build/
sdkconfig
sdkconfig.old
# Fetched dependencies. The sources are downloaded by the component manager, but the
# lock file is committed: it is what makes the resolution reproducible, and LVGL's
# memory behaviour is part of this project's design.
managed_components/
!dependencies.lock

# Host build output
host/build/

# Python caches from the tools that import a sibling module
__pycache__/
*.pyc

# macOS
.DS_Store

# Generated config for the visual backlight test build
sdkconfig.backlight-test

.scratch/
sdkconfig.verify
sdkconfig.headless

# The CA that signs the shipped leaf stays offline: the leaf key is public by design
# (it is compiled into every firmware), the CA key is not.
tls/ca.key
tls/ca.srl
tls/*.csr

# The label artwork's sources are 27 MB of binaries. The exported JPEG and PNG are what the
# build and the screen use; the .psd stays on the machine that draws it.
assets/labels/*.psd

# The ReUI agent skill is installed by its own installer and updated there, not vendored.
.agents/
