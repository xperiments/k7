/*
 * Copy this file to main/wifi_credentials.h and fill in your network.
 *
 * main/wifi_credentials.h is gitignored, so a real network password never enters
 * version control while still being compiled into the binary - which is what the
 * device does with it. There is no runtime provisioning mechanism: changing these
 * is an edit and a reflash.
 */
#pragma once

#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-password"
