# The development board accepts the App served at
# https://k7-dev.xperiments.dev:8000 besides the deployed one, so connected mode can be
# developed against the panel (tools/build.sh dev; docs/adr/0082). The panel's build and flash
# take the option from sdkconfig.defaults.sunton; only the release leaves it out
# (sdkconfig.defaults.release). This file is kept for a build that names the variant itself.
CONFIG_K7_TRUST_DEV_ORIGIN=y
