{
  "name": "label-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The K7Art editor: design a cassette's label and J-card, preview the label with LVGL, export the K7Art and publish a pack.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "connect": "node scripts/connect.mjs",
    "e2e:webmcp": "playwright test --project=webmcp-native",
    "test-label": "node scripts/test-label.mjs",
    "mcp": "node src/webmcp/mcp-server.ts",
    "mcp:http": "node src/webmcp/mcp-server.ts --http 8787",
    "skill": "node scripts/build-skill.mjs",
    "skill:check": "node scripts/build-skill.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^0.544.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
